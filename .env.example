

# Port Host Mapping
FRONTEND_PORT=80
BACKEND_PORT=8000

# Basis Data MySQL
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=toko_bangunan
DB_USERNAME=tb_user
DB_PASSWORD=your_secure_db_password
DB_ROOT_PASSWORD=your_secure_root_password

# Laravel Key & Debug
APP_KEY=base64:your_generated_laravel_app_key_here
APP_DEBUG=false

# Monitoring Grafana 
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password
